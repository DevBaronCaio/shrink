generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Theme {
  DARK
  LIGHT
  SYSTEM
}

enum ApiScope {
  READ
  WRITE
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  passwordHash  String?
  emailVerified DateTime? @db.Timestamptz(3)
  image         String?
  theme         Theme     @default(DARK)
  timezone      String    @default("America/Belem")
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)
  accounts      Account[]
  sessions      Session[]
  links         Link[]
  tags          Tag[]
  apiKeys       ApiKey[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime @db.Timestamptz(3)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime @db.Timestamptz(3)

  @@unique([identifier, token])
}

model Link {
  id             String       @id @default(cuid())
  userId         String
  slug           String       @unique @db.VarChar(48)
  destinationUrl String
  title          String
  description    String?
  isActive       Boolean      @default(true)
  expiresAt      DateTime?    @db.Timestamptz(3)
  clickLimit     Int?
  clickCount     Int          @default(0)
  utm            Json?
  qr             Json?
  qrCreatedAt    DateTime?    @db.Timestamptz(3)
  blockedAt      DateTime?    @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  events         ClickEvent[]
  tags           LinkTag[]
  reports        LinkReport[]

  @@index([userId, createdAt(sort: Desc), id])
  @@index([userId, clickCount(sort: Desc), id])
}

model ClickEvent {
  id              String   @id @default(uuid()) @db.Uuid
  linkId          String
  country         String?  @db.VarChar(2)
  region          String?  @db.VarChar(3)
  device          String?
  browser         String?
  operatingSystem String?
  referrerDomain  String?
  visitorHash     String?  @db.VarChar(64)
  isBot           Boolean  @default(false)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  link            Link     @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([linkId, createdAt])
  @@index([createdAt])
}

model Tag {
  id        String    @id @default(cuid())
  userId    String
  name      String
  color     String    @default("#FACC15")
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  links     LinkTag[]

  @@unique([userId, name])
}

model LinkTag {
  linkId String
  tagId  String
  link   Link   @relation(fields: [linkId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([linkId, tagId])
  @@index([tagId])
}

model ApiKey {
  id         String     @id @default(cuid())
  userId     String
  name       String
  prefix     String     @unique
  keyHash    String     @db.Char(64)
  scopes     ApiScope[]
  lastUsedAt DateTime?  @db.Timestamptz(3)
  expiresAt  DateTime?  @db.Timestamptz(3)
  revokedAt  DateTime?  @db.Timestamptz(3)
  createdAt  DateTime   @default(now()) @db.Timestamptz(3)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
}

model RateLimitBucket {
  key       String
  windowAt  DateTime @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
  hits      Int

  @@id([key, windowAt])
  @@index([expiresAt])
}

model LinkReport {
  id        String   @id @default(cuid())
  linkId    String
  reason    String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  link      Link     @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([linkId, createdAt])
  @@index([createdAt])
}
