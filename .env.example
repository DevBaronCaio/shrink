DATABASE_URL=
DIRECT_URL=
AUTH_SECRET=
# Exige pelo menos 32 caracteres aleatórios. Use um valor separado por ambiente.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
# Opcional, exclusivo para estimativa de visitantes. Use um segredo independente.
ANALYTICS_HASH_SECRET=
# Obrigatório em produção para o cron diário de retenção.
CRON_SECRET=
# Domínios separados por vírgula. Subdomínios também são bloqueados.
BLOCKED_DOMAINS=
# IDs OAuth imutáveis separados por vírgula, por exemplo github:12345,google:12345.
MODERATOR_IDENTITIES=
# Opcional, URL pública HTTPS do repositório.
NEXT_PUBLIC_GITHUB_URL=
